<template>
  <div class="container">
    <div class="header">
      <text class="title">全能AI</text>
      <div class="header-actions">
        <text class="action-btn" onclick="onClear">清空</text>
        <text class="action-btn" onclick="onSettings">设置</text>
      </div>
    </div>

    <div class="msg-list">
      <div class="msg-item" for="{{ messages }}">
        <div class="msg-bubble msg-ai" if="{{ $item.role !== 'user' }}">
          <text class="msg-text">{{ $item.content }}</text>
        </div>
        <div class="msg-bubble msg-user" if="{{ $item.role === 'user' }}">
          <text class="msg-text msg-text-white">{{ $item.content }}</text>
        </div>
      </div>

      <div class="msg-item" if="{{ loading }}">
        <div class="msg-bubble msg-ai">
          <text class="msg-text">正在思考…</text>
        </div>
      </div>

      <div class="empty-wrap" if="{{ showEmpty }}">
        <text class="empty-text">你好，我是全能AI</text>
        <text class="empty-sub">请先在设置中填写 API Key</text>
      </div>
    </div>

    <div class="input-bar">
      <input
        class="input"
        type="text"
        value="{{ inputText }}"
        placeholder="输入问题"
        onchange="onInputChange"
      ></input>
      <input class="send-btn" type="button" value="发送" onclick="onSend"></input>
    </div>
  </div>
</template>

<script>
var ai = require('../../helper/ai.js')
var storage = require('../../helper/storage.js')
var router = require('@blueos.app.appmanager.router')

export default {
  data: {
    inputText: '',
    loading: false,
    messages: [],
    settings: {},
    activated: false,
    showEmpty: true
  },

  onInit() {
    var self = this
    try {
      storage.isActivated().then(function (activated) {
        self.activated = activated
        if (!activated) {
          try { router.push({ uri: '/pages/Activate' }) } catch (e) {}
          return
        }
        return storage.getSettings()
      }).then(function (s) {
        if (s) self.settings = s
        return storage.getHistory()
      }).then(function (h) {
        if (h) self.messages = h
        self.updateEmpty()
      }).catch(function () {})
    } catch (e) {}
  },

  onShow() {
    var self = this
    try {
      storage.isActivated().then(function (activated) {
        self.activated = activated
        if (!activated) {
          try { router.push({ uri: '/pages/Activate' }) } catch (e) {}
          return
        }
        return storage.getSettings()
      }).then(function (s) {
        if (s) self.settings = s
      }).catch(function () {})
    } catch (e) {}
  },

  updateEmpty() {
    this.showEmpty = (this.messages.length === 0 && !this.loading)
  },

  onInputChange(e) {
    var val = ''
    if (e) {
      if (e.value != null) val = e.value
      else if (e.text != null) val = e.text
      else if (typeof e === 'string') val = e
    }
    this.inputText = val
  },

  onSettings() {
    try {
      router.push({ uri: '/pages/Settings' })
    } catch (e) {}
  },

  onClear() {
    this.messages = []
    this.updateEmpty()
    try { storage.clearHistory() } catch (e) {}
  },

  onSend() {
    var self = this
    var text = String(this.inputText || '').trim()
    if (!text) return
    if (this.loading) return

    self.pushMessage('user', text)
    self.inputText = ''
    self.loading = true
    self.updateEmpty()

    var aiHistory = self.messages.slice(0, -1)

    try {
      storage.isActivated().then(function (activated) {
        if (!activated) {
          self.pushMessage('assistant', '请先激活应用后再使用')
          self.loading = false
          self.updateEmpty()
          try { router.push({ uri: '/pages/Activate' }) } catch (e) {}
          return
        }
        if (!self.settings.apiKey) {
          self.pushMessage('assistant', '请先在设置中填写 API Key')
          self.loading = false
          self.updateEmpty()
          return
        }
        return ai.chat({
          baseUrl: self.settings.baseUrl,
          apiKey: self.settings.apiKey,
          model: self.settings.model,
          systemPrompt: self.settings.systemPrompt,
          history: aiHistory,
          userText: text
        })
      }).then(function (reply) {
        if (reply) self.pushMessage('assistant', reply)
      }).catch(function (err) {
        var msg = (err && err.message) ? err.message : '请求失败'
        self.pushMessage('assistant', '出错：' + msg)
      }).then(function () {
        self.loading = false
        self.updateEmpty()
      })
    } catch (e) {
      self.loading = false
      self.updateEmpty()
      self.pushMessage('assistant', '异常：' + (e && e.message ? e.message : e))
    }
  },

  pushMessage(role, content) {
    var item = { role: role, content: String(content || '') }
    this.messages = this.messages.concat([item])
    this.updateEmpty()
    try { storage.setHistory(this.messages) } catch (e) {}
  }
}
</script>

<style>
.container {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #f5f6f8;
}
.header {
  height: 60px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 14px;
  padding-right: 14px;
  background-color: #1890ff;
}
.title {
  font-size: 28px;
  color: #ffffff;
  font-weight: bold;
}
.header-actions {
  flex-direction: row;
  align-items: center;
}
.action-btn {
  font-size: 22px;
  color: #ffffff;
  margin-left: 16px;
}
.msg-list {
  flex-grow: 1;
  flex-direction: column;
  padding: 8px 12px;
}
.msg-item {
  margin-bottom: 8px;
}
.msg-bubble {
  padding: 12px 14px;
  border-radius: 12px;
  max-width: 82%;
}
.msg-ai {
  background-color: #ffffff;
}
.msg-user {
  background-color: #1890ff;
}
.msg-text {
  font-size: 24px;
  color: #333333;
}
.msg-text-white {
  color: #ffffff;
}
.empty-wrap {
  flex-direction: column;
  align-items: center;
  margin-top: 80px;
}
.empty-text {
  font-size: 26px;
  color: #1890ff;
  margin-bottom: 12px;
}
.empty-sub {
  font-size: 20px;
  color: #999999;
}
.input-bar {
  height: 88px;
  flex-direction: row;
  align-items: center;
  padding: 8px 12px;
  background-color: #ffffff;
  border-top-color: #e6e6e6;
  border-top-width: 1px;
}
.input {
  flex-grow: 1;
  height: 64px;
  font-size: 24px;
  padding-left: 12px;
  border-radius: 10px;
  background-color: #f0f2f5;
  color: #333333;
}
.send-btn {
  width: 96px;
  height: 64px;
  margin-left: 10px;
  font-size: 26px;
  color: #ffffff;
  background-color: #1890ff;
  border-radius: 10px;
}
</style>
