  height: 70px;
  font-size: 28px;
  color: #ffffff;
  background-color: #1890ff;
  border-radius: 10px;
  margin-top: 10px;
}

.tip {
  font-size: 20px;
  color: #f5222d;
  margin-top: 6px;
}

