  font-size: 24px;
  color: #666666;
  margin-bottom: 8px;
}

.field {
  height: 70px;
  font-size: 26px;
  padding-left: 16px;
  border-radius: 12px;
  background-color: #ffffff;
  color: #333333;
}

.activate-btn {
  height: 80px;
  font-size: 30px;
  color: #ffffff;
  background-color: #1890ff;
  border-radius: 12px;
  margin-top: 12px;
}

.tip {
  font-size: 22px;
  color: #f5222d;
  margin-top: 8px;
}

.ok-text {
  font-size: 26px;
  color: #52c41a;
  margin-top: 10px;
}

.pay-box {
  margin-top: 10px;
  padding: 16px;
  background-color: #ffffff;
  border-radius: 12px;
  flex-direction: column;
}

.pay-title {
  font-size: 26px;
  color: #1890ff;
  margin-bottom: 8px;
  font-weight: bold;
}

.pay-row {
  font-size: 22px;
  color: #333333;
  margin-top: 6px;
}

.contact {
  color: #1890ff;
  font-weight: bold;
}

