<template>
  <div class="container">
    <!-- 标题栏 -->
    <div class="header">
      <text class="back-btn" onclick="onBack">&lt; 返回</text>
      <text class="title">激活</text>
    </div>

    <scroll class="body" scroll-y="true">
      <!-- 激活状态 -->
      <div class="status-box {{ activated ? 'ok' : 'pending' }}">
        <text class="status-text">{{ activated ? '已激活' : '未激活' }}</text>
      </div>

      <!-- 输入激活码 -->
      <div class="row" if="{{ !activated }}">
        <text class="label">输入激活码</text>
        <input
          id="codeInput"
          class="field"
          type="text"
          value="{{ code }}"
          placeholder="请输入激活码"
          onchange="onCodeChange"
        ></input>

        <input
          class="activate-btn"
          type="button"
          value="激活"
          onclick="onActivate"
        ></input>

        <text class="tip" if="{{ errMsg }}">{{ errMsg }}</text>
      </div>

      <!-- 已激活 -->
      <div class="row" if="{{ activated }}">
        <text class="ok-text">应用已激活，可正常使用。</text>
      </div>

      <!-- 付款说明 + 微信支付二维码 -->
      <div class="pay-box">
        <text class="pay-title">购买激活码</text>
        <text class="pay-row">价格：{{ price }}</text>
        <text class="pay-row">付款后凭支付证明联系：</text>
        <text class="pay-row contact">{{ contact }}</text>

        <!-- 微信支付二维码 -->
        <div class="qr-wrap">
          <text class="qr-label">微信扫码付款</text>
          <image class="qr-img" src="/assets/images/wechat-pay-qr.jpg"></image>
          <text class="qr-tip">长按识别或截图保存到微信扫一扫</text>
        </div>

        <text class="pay-note">获取激活码后填入上方输入框即可离线激活</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import storage from '../../helper/storage.js'

export default {
  data: {
    activated: false,
    code: '',
    errMsg: '',
    price: storage.ACTIVATION_NOTICE.price,
    contact: storage.ACTIVATION_NOTICE.contact
  },

  async onInit() {
    this.activated = await storage.isActivated()
  },

  onCodeChange(e) {
    this.code = (e && e.value != null) ? e.value : ''
    this.errMsg = ''
  },

  async onActivate() {
    const ok = await storage.activate(this.code)
    if (ok) {
      this.activated = true
      this.errMsg = ''
      this.showToast('激活成功')
    } else {
      this.errMsg = '激活码错误，请检查'
    }
  },

  onBack() {
    try {
      this.$page.back && this.$page.back()
    } catch (e) {
      const router = require('@blueos.app.router')
      router.back && router.back()
    }
  },

  showToast(text) {
    try {
      const prompt = require('@blueos.app.prompt')
      prompt.showToast({ message: text })
    } catch (e) {
      console.log('toast:', text)
    }
  }
}
</script>

<style>
