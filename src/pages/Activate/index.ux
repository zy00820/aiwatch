<template>
  <div class="container">
    <!-- 标题栏 -->
    <div class="header">
      <text class="back-btn" onclick="onBack">&lt; 返回</text>
      <text class="title">激活</text>
    </div>

    <div class="body">
      <!-- 激活状态 -->
      <div class="{{ activated ? 'status-box-ok' : 'status-box-pending' }}">
        <text class="{{ activated ? 'status-text-ok' : 'status-text-pending' }}">{{ activated ? '已激活' : '未激活' }}</text>
      </div>

      <!-- 输入激活码 -->
      <div class="row" if="{{ !activated }}">
        <text class="label">输入激活码</text>
        <input
          id="codeInput"
          class="field"
          type="text"
          value="{{ code }}"
          placeholder="请输入激活码"
          onchange="onCodeChange"
        ></input>

        <input
          class="activate-btn"
          type="button"
          value="激活"
          onclick="onActivate"
        ></input>

        <text class="tip" if="{{ errMsg }}">{{ errMsg }}</text>
      </div>

      <!-- 已激活 -->
      <div class="row" if="{{ activated }}">
        <text class="ok-text">应用已激活，可正常使用。</text>
      </div>

      <!-- 付款说明 + 微信支付二维码 -->
      <div class="pay-box">
        <text class="pay-title">购买激活码</text>
        <text class="pay-row">价格：{{ price }}</text>
        <text class="pay-row">付款后凭支付证明联系：</text>
        <text class="pay-contact">{{ contact }}</text>

        <!-- 微信支付二维码 -->
        <div class="qr-wrap">
          <text class="qr-label">微信扫码付款</text>
          <image class="qr-img" src="/assets/images/wechat-pay-qr.png"></image>
          <text class="qr-tip">长按识别或截图保存到微信扫一扫</text>
        </div>

        <text class="pay-note">获取激活码后填入上方输入框即可离线激活</text>
      </div>
    </div>
  </div>
</template>

<script>
var storage = require('../../helper/storage.js')
var router = require('@blueos.app.appmanager.router')
var prompt = require('@blueos.window.prompt')

export default {
  data: {
    activated: false,
    code: '',
    errMsg: '',
    price: (storage && storage.ACTIVATION_NOTICE && storage.ACTIVATION_NOTICE.price) || '4元',
    contact: (storage && storage.ACTIVATION_NOTICE && storage.ACTIVATION_NOTICE.contact) || 'zy291817@outlook.com'
  },

  onInit() {
    var self = this
    storage.isActivated().then(function (v) { self.activated = v }).catch(function () {})
  },

  onCodeChange(e) {
    this.code = (e && e.value != null) ? e.value : ''
    this.errMsg = ''
  },

  onActivate() {
    var self = this
    storage.activate(this.code).then(function (ok) {
      if (ok) {
        self.activated = true
        self.errMsg = ''
        self.showToast('激活成功')
      } else {
        self.errMsg = '激活码错误，请检查'
      }
    }).catch(function () {})
  },

  onBack() {
    try {
      this.$page.back && this.$page.back()
    } catch (e) {
      router.back && router.back()
    }
  },

  showToast(text) {
    try {
      prompt.showToast({ message: text })
    } catch (e) {
      console.log('toast:', text)
    }
  }
}
</script>

