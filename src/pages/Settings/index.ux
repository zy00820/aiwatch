<template>
  <div class="container">
    <!-- 标题栏 -->
    <div class="header">
      <text class="back-btn" onclick="onBack">&lt; 返回</text>
      <text class="title">设置</text>
    </div>

    <scroll class="body" scroll-y="true">
      <!-- 激活状态 -->
      <div class="act-box {{ activated ? 'act-ok' : 'act-pending' }}">
        <text class="act-label">激活状态：</text>
        <text class="act-value">{{ activated ? '已激活' : '未激活' }}</text>
      </div>
      <input
        class="activate-entry-btn"
        type="button"
        value="{{ activated ? '查看激活信息' : '输入激活码' }}"
        onclick="onGotoActivate"
      ></input>

      <!-- 接口地址 -->
      <div class="row">
        <text class="label">接口地址</text>
        <input
          class="field"
          type="text"
          value="{{ form.baseUrl }}"
          placeholder="https://api.xxx/v1/chat/completions"
          onchange="onBaseUrlChange"
        ></input>
      </div>

      <!-- API Key -->
      <div class="row">
        <text class="label">API Key</text>
        <input
          class="field"
          type="text"
          value="{{ form.apiKey }}"
          placeholder="sk-..."
          onchange="onApiKeyChange"
        ></input>
      </div>

      <!-- 模型 -->
      <div class="row">
        <text class="label">模型</text>
        <input
          class="field"
          type="text"
          value="{{ form.model }}"
          placeholder="Qwen/Qwen2.5-7B-Instruct"
          onchange="onModelChange"
        ></input>
      </div>

      <!-- 系统提示词 -->
      <div class="row">
        <text class="label">系统提示词</text>
        <input
          class="field"
          type="text"
          value="{{ form.systemPrompt }}"
          placeholder="例如：你是简洁的助手"
          onchange="onPromptChange"
        ></input>
      </div>

      <!-- 保存 -->
      <input
        class="save-btn"
        type="button"
        value="保存"
        onclick="onSave"
      ></input>

      <input
        class="reset-btn"
        type="button"
        value="恢复默认"
        onclick="onReset"
      ></input>

      <div class="tip-box">
        <text class="tip-title">免费接入说明</text>
        <text class="tip">1. 登录 SiliconFlow 官网</text>
        <text class="tip">2. 领取免费 API Key</text>
        <text class="tip">3. 粘贴到上方，保存即可</text>
        <text class="tip">兼容 OpenAI 协议接口</text>
      </div>

      <!-- 关于 -->
      <div class="about-box">
        <text class="about-title">关于</text>
        <text class="about-row">应用名称：AI助手</text>
        <text class="about-row">版本：v{{ version }}</text>
        <text class="about-row">开发者：张岳</text>
        <text class="about-row">开发团队：小默软件工作室</text>
        <text class="about-row">联系方式：zy291817@outlook.com</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import storage from '../../helper/storage.js'

export default {
  data: {
    version: '1.0.2',
    activated: false,
    form: {
      baseUrl: '',
      apiKey: '',
      model: '',
      systemPrompt: ''
    }
  },

  async onInit() {
    this.activated = await storage.isActivated()
    const settings = await storage.getSettings()
    this.form = {
      baseUrl: settings.baseUrl,
      apiKey: settings.apiKey,
      model: settings.model,
      systemPrompt: settings.systemPrompt
    }
  },

  async onShow() {
    // 从激活页返回后刷新激活状态
    this.activated = await storage.isActivated()
  },

  onGotoActivate() {
    try {
      const router = require('@blueos.app.router')
      router.push({ uri: '/Activate' })
    } catch (e) {
      console.log('router push failed: ' + e)
    }
  },

  onBaseUrlChange(e) {
    this.form.baseUrl = (e && e.value != null) ? e.value : ''
  },

  onApiKeyChange(e) {
    this.form.apiKey = (e && e.value != null) ? e.value : ''
  },

  onModelChange(e) {
    this.form.model = (e && e.value != null) ? e.value : ''
  },

  onPromptChange(e) {
    this.form.systemPrompt = (e && e.value != null) ? e.value : ''
  },

  async onSave() {
    const ok = await storage.setSettings(this.form)
    this.showToast(ok ? '已保存' : '保存失败')
    if (ok) {
      this.onBack()
    }
  },

  onReset() {
    this.form = {
      baseUrl: storage.DEFAULT_SETTINGS.baseUrl,
      apiKey: '',
      model: storage.DEFAULT_SETTINGS.model,
      systemPrompt: storage.DEFAULT_SETTINGS.systemPrompt
    }
  },

  onBack() {
    try {
      this.$page.back && this.$page.back()
    } catch (e) {
      const router = require('@blueos.app.router')
      router.back && router.back()
    }
  },

  showToast(text) {
    try {
      const prompt = require('@blueos.app.prompt')
      prompt.showToast({ message: text })
    } catch (e) {
      console.log('toast:', text)
    }
  }
}
</script>

