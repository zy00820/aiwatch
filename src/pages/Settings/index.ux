<template>
  <div class="container">
    <!-- 标题栏 -->
    <div class="header">
      <text class="back-btn" onclick="onBack">&lt; 返回</text>
      <text class="title">设置</text>
    </div>

    <div class="body">
      <!-- 激活状态 -->
      <div class="{{ activated ? 'act-box-ok' : 'act-box-pending' }}">
        <text class="act-label">激活状态：</text>
        <text class="{{ activated ? 'act-value-ok' : 'act-value-pending' }}">{{ activated ? '已激活' : '未激活' }}</text>
      </div>
      <input
        class="activate-entry-btn"
        type="button"
        value="{{ activated ? '查看激活信息' : '输入激活码' }}"
        onclick="onGotoActivate"
      ></input>

      <!-- 接口地址 -->
      <div class="row">
        <text class="label">接口地址</text>
        <input
          class="field"
          type="text"
          value="{{ form.baseUrl }}"
          placeholder="https://api.xxx/v1/chat/completions"
          onchange="onBaseUrlChange"
        ></input>
      </div>

      <!-- API Key -->
      <div class="row">
        <text class="label">API Key</text>
        <input
          class="field"
          type="text"
          value="{{ form.apiKey }}"
          placeholder="sk-..."
          onchange="onApiKeyChange"
        ></input>
      </div>

      <!-- 模型 -->
      <div class="row">
        <text class="label">模型</text>
        <input
          class="field"
          type="text"
          value="{{ form.model }}"
          placeholder="Qwen/Qwen2.5-7B-Instruct"
          onchange="onModelChange"
        ></input>
      </div>

      <!-- 系统提示词 -->
      <div class="row">
        <text class="label">系统提示词</text>
        <input
          class="field"
          type="text"
          value="{{ form.systemPrompt }}"
          placeholder="例如：你是简洁的助手"
          onchange="onPromptChange"
        ></input>
      </div>

      <!-- 输入法设置 -->
      <div class="sec-title"><text>输入法</text></div>

      <div class="row">
        <text class="label">输入方式</text>
        <div class="seg-row">
          <input class="seg-btn {{ form.inputMethod==='official' ? 'seg-active' : '' }}" type="button" value="官方输入法" onclick="onSetInputMethod('official')"></input>
          <input class="seg-btn {{ form.inputMethod==='pinyin' ? 'seg-active' : '' }}" type="button" value="拼音输入法" onclick="onSetInputMethod('pinyin')"></input>
        </div>
      </div>

      <div class="row">
        <text class="label">拼音布局</text>
        <div class="seg-row">
          <input class="seg-btn {{ form.pinyinLayout==='26' ? 'seg-active' : '' }}" type="button" value="26键" onclick="onSetLayout('26')"></input>
          <input class="seg-btn {{ form.pinyinLayout==='9' ? 'seg-active' : '' }}" type="button" value="9键" onclick="onSetLayout('9')"></input>
        </div>
      </div>

      <div class="row">
        <text class="label">默认语言</text>
        <div class="seg-row">
          <input class="seg-btn {{ form.defaultLang==='zh' ? 'seg-active' : '' }}" type="button" value="中文" onclick="onSetLang('zh')"></input>
          <input class="seg-btn {{ form.defaultLang==='en' ? 'seg-active' : '' }}" type="button" value="英文" onclick="onSetLang('en')"></input>
        </div>
      </div>

      <!-- 保存 -->
      <input
        class="save-btn"
        type="button"
        value="保存"
        onclick="onSave"
      ></input>

      <input
        class="reset-btn"
        type="button"
        value="恢复默认"
        onclick="onReset"
      ></input>

      <div class="tip-box">
        <text class="tip-title">免费接入说明</text>
        <text class="tip">1. 登录 SiliconFlow 官网</text>
        <text class="tip">2. 领取免费 API Key</text>
        <text class="tip">3. 粘贴到上方，保存即可</text>
        <text class="tip">兼容 OpenAI 协议接口</text>
      </div>

      <!-- 关于 -->
      <div class="about-box">
        <text class="about-title">关于</text>
        <text class="about-row">应用名称：全能AI</text>
        <text class="about-row">版本：v{{ version }}</text>
        <text class="about-row">开发者：张岳</text>
        <text class="about-row">开发团队：小默软件工作室</text>
        <text class="about-row">联系方式：zy291817@outlook.com</text>
      </div>
    </div>
  </div>
</template>

<script>
var storage = require('../../helper/storage.js')
var router = require('@blueos.app.appmanager.router')
var prompt = require('@blueos.window.prompt')

export default {
  data: {
    version: '1.2.6',
    activated: false,
    form: {
      baseUrl: '',
      apiKey: '',
      model: '',
      systemPrompt: '',
      inputMethod: 'pinyin',
      pinyinLayout: '26',
      defaultLang: 'zh'
    }
  },

  onInit() {
    var self = this
    storage.isActivated().then(function (v) {
      self.activated = v
      return storage.getSettings()
    }).then(function (settings) {
      self.form = {
        baseUrl: settings.baseUrl,
        apiKey: settings.apiKey,
        model: settings.model,
        systemPrompt: settings.systemPrompt,
        inputMethod: settings.inputMethod || 'pinyin',
        pinyinLayout: settings.pinyinLayout || '26',
        defaultLang: settings.defaultLang || 'zh'
      }
    }).catch(function () {})
  },

  onShow() {
    var self = this
    storage.isActivated().then(function (v) { self.activated = v }).catch(function () {})
  },

  onGotoActivate() {
    try {
      router.push({ uri: '/pages/Activate' })
    } catch (e) {
      console.log('router push failed: ' + e)
    }
  },

  onBaseUrlChange(e) {
    this.form.baseUrl = (e && e.value != null) ? e.value : ''
  },

  onApiKeyChange(e) {
    this.form.apiKey = (e && e.value != null) ? e.value : ''
  },

  onModelChange(e) {
    this.form.model = (e && e.value != null) ? e.value : ''
  },

  onPromptChange(e) {
    this.form.systemPrompt = (e && e.value != null) ? e.value : ''
  },

  onSetInputMethod(v) {
    this.form.inputMethod = v
  },

  onSetLayout(v) {
    this.form.pinyinLayout = v
  },

  onSetLang(v) {
    this.form.defaultLang = v
  },

  onSave() {
    var self = this
    storage.setSettings(this.form).then(function (ok) {
      self.showToast(ok ? '已保存' : '保存失败')
      if (ok) {
        self.onBack()
      }
    }).catch(function () {})
  },

  onReset() {
    this.form = {
      baseUrl: storage.DEFAULT_SETTINGS.baseUrl,
      apiKey: '',
      model: storage.DEFAULT_SETTINGS.model,
      systemPrompt: storage.DEFAULT_SETTINGS.systemPrompt,
      inputMethod: storage.DEFAULT_SETTINGS.inputMethod,
      pinyinLayout: storage.DEFAULT_SETTINGS.pinyinLayout,
      defaultLang: storage.DEFAULT_SETTINGS.defaultLang
    }
  },

  onBack() {
    try {
      this.$page.back && this.$page.back()
    } catch (e) {
      router.back && router.back()
    }
  },

  showToast(text) {
    try {
      prompt.showToast({ message: text })
    } catch (e) {
      console.log('toast:', text)
    }
  }
}
</script>

